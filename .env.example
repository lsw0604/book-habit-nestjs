DATABASE_URL="mysql://app:app@localhost:3306/book_habit_nest"

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=book_habit_nest
MYSQL_USER=app
MYSQL_PASSWORD=app

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:4000

# OAuth 완료 후 브라우저를 되돌려 보낼 프론트 주소
FRONTEND_URL=http://localhost:3001

KAKAO_CLIENT_ID=change-me-kakao-client-id
# 카카오 개발자 콘솔의 Redirect URI와 반드시 동일해야 하며,
# 프론트가 아니라 백엔드의 콜백 라우트를 가리킨다.
KAKAO_CALLBACK_URL=http://localhost:3000/api/auth/kakao/callback
# 카카오 콘솔에서 client_secret을 켠 경우에만 채움 (비우면 전송하지 않음)
KAKAO_CLIENT_SECRET=

ALADIN_TTB_KEY=
KAKAO_REST_API=
