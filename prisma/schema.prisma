generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Provider {
  LOCAL
  KAKAO
}

enum Gender {
  MALE
  FEMALE
}

enum MyBookStatus {
  WANT_TO_READ // 읽고 싶은 책
  CURRENTLY_READING // 읽는 중
  READ // 읽음
}

enum ReadingGoalMetric {
  BOOK_COUNT
  PAGE_COUNT
  MINUTES
}

// 독서 노트 기록법 템플릿. 섹션 구성은 src/book-note/book-note.templates.ts가 정한다.
enum BookNoteTemplate {
  ONE_SENTENCE
  BON_KKAE_JEOK
  KWL
  THREE_TWO_ONE
  FREE
}

model Book {
  id          Int       @id @default(autoincrement())
  title       String
  subTitle    String?
  isbn        String    @unique @db.VarChar(13)
  authors     Json?
  translators Json?
  publisher   String?
  thumbnail   String?
  coverImage  String?
  // YES24 상품 상세 링크만 담는다(YES24에 없으면 null). YES24 Open API 약관상 YES24
  // 데이터(totalPage 보충)를 보여주는 화면에 출처로 표시해야 한다.
  url         String?   @db.Text
  pubDate     DateTime? @db.Date
  totalPage   Int?
  myBook      MyBook[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model User {
  id          Int           @id @default(autoincrement())
  email       String?       @unique
  password    String?
  name        String?
  birthday    DateTime?     @db.Date
  gender      Gender?
  provider    Provider      @default(LOCAL)
  profile     String?
  myBook      MyBook[]
  readingGoal ReadingGoal[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model MyBook {
  id          Int          @id @default(autoincrement())
  userId      Int
  bookId      Int
  rating      Int          @default(0)
  status      MyBookStatus @default(WANT_TO_READ)
  currentPage Int          @default(0)
  // 사용자가 직접 입력한 이 책의 총 페이지 수. null이면 Book.totalPage를 쓴다.
  // 외부 API에 페이지 수가 없는 책(오래된 책 등)과, 전자책/판본처럼 같은 ISBN이라도
  // 쪽수가 다른 경우를 사용자가 보정하기 위함 (resolveTotalPage 참고).
  totalPage   Int?
  readCount   Int          @default(0)
  startedAt   DateTime? // 처음 CURRENTLY_READING으로 전환된 시각
  finishedAt  DateTime? // 가장 최근 READ로 전환된 시각
  lastReadAt  DateTime? // 가장 최근 ReadingLog 기록 시각

  readingLog ReadingLog[]
  quote      Quote[]
  note       BookNote?
  tag        MyBookTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
  @@index([userId, status])
}

model Tag {
  id        Int         @id @default(autoincrement())
  value     String      @unique
  chosung   String // 초성 자동완성 검색용. value에서 추출한 초성 문자열 (예: "자기계발" -> "ㅈㄱㄱㅂ")
  myBookTag MyBookTag[]
}

model MyBookTag {
  id        Int      @id @default(autoincrement())
  myBookId  Int
  tagId     Int
  createdAt DateTime @default(now())
  myBook    MyBook   @relation(fields: [myBookId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([myBookId, tagId])
}

// 독서 세션 기록. 이름을 MyBookHistory -> ReadingLog로 변경함
// ("History"는 감사로그처럼 읽히는데, 실제로는 습관 트래킹의 핵심 데이터라서)
model ReadingLog {
  id             Int      @id @default(autoincrement())
  myBookId       Int
  startPage      Int
  endPage        Int
  startTime      DateTime
  endTime        DateTime
  readingMinutes Int
  date           DateTime @db.Date
  // 그날의 감상/기분도 여기에 자유롭게 적는다. 예전엔 readingMood(enum)를 따로 뒀지만
  // 감정은 열거로 덮을 수 없어(값이 12개까지 늘고 결국 nullable이 됨) 자유 서술로 통합함.
  // 다시 구조화하려면 "집계해서 보여줄 화면"이 먼저 있어야 한다 - 이전엔 저장만 하고
  // 어디서도 필터/집계하지 않아 입력 마찰만 남았다.
  memo           String?  @db.VarChar(500)
  quote          Quote[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  myBook         MyBook   @relation(fields: [myBookId], references: [id], onDelete: Cascade)

  @@index([myBookId, date])
}

// 책에서 저장한 인용구/하이라이트. 책(MyBook)에 속하고, 어느 독서 기록 중에 남겼는지는 선택이다.
// 예전엔 ReadingLog에만 매달려(Cascade) 기록을 지우면 인용도 사라졌고, 인용 하나 남기려고
// 진행률을 바꾸는 독서 기록부터 만들어야 했다. 이제 기록을 지우면 연결만 풀린다(SetNull).
// MyBook 삭제 시 Quote로 오는 경로가 둘(직접 Cascade, ReadingLog 경유 SetNull)이다. 한쪽이
// SetNull인 이 경우는 MySQL이 허용한다 - 마이그레이션 적용 후 실제 DB에서 삭제해 확인함.
model Quote {
  id           Int         @id @default(autoincrement())
  myBookId     Int
  readingLogId Int?
  page         Int
  content      String      @db.Text
  createdAt    DateTime    @default(now())
  myBook       MyBook      @relation(fields: [myBookId], references: [id], onDelete: Cascade)
  readingLog   ReadingLog? @relation(fields: [readingLogId], references: [id], onDelete: SetNull)

  @@index([myBookId, page])
  @@index([readingLogId])
}

// 기간별 독서 목표 (연간: month=null / 월간: month 값 있음)
model ReadingGoal {
  id          Int               @id @default(autoincrement())
  userId      Int
  year        Int
  month       Int?
  metric      ReadingGoalMetric
  targetValue Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month, metric])
}

// 책 한 권 단위 개인 노트(비공개). MyBook당 하나.
// userId FK를 따로 두지 않는다 - MyBook(userId, Cascade)에서 cascade가 이미 오므로 하나 더 걸면
// MySQL이 "multiple cascade paths"로 거부한다. 소유권은 MyBook을 통해서만 확인한다.
model BookNote {
  id        Int               @id @default(autoincrement())
  myBookId  Int               @unique
  template  BookNoteTemplate
  sections  BookNoteSection[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  myBook    MyBook            @relation(fields: [myBookId], references: [id], onDelete: Cascade)
}

// 노트의 섹션 하나 = 한 행. key 목록은 템플릿 정의가 정하고 서비스가 검증한다.
// 빈 섹션은 행을 두지 않는다(응답에서 템플릿의 모든 섹션을 채워 보낸다).
// 섹션마다 updatedAt이 있어 "읽기 전/읽은 후"처럼 나뉘는 기록의 시점이 남는다.
model BookNoteSection {
  id         Int      @id @default(autoincrement())
  bookNoteId Int
  key        String   @db.VarChar(30)
  content    String   @db.Text
  updatedAt  DateTime @updatedAt
  bookNote   BookNote @relation(fields: [bookNoteId], references: [id], onDelete: Cascade)

  @@unique([bookNoteId, key])
}
